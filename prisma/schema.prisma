datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Gerador: Cria o Prisma Client (a ponte Node.js -> Banco)
generator client {
  provider = "prisma-client-js"
}

// =========================================================
// INÍCIO DOS MODELS DO PROJETO
// =========================================================

// === ENUMS (Regras de Negócio) ===

// 1. Enum Role: Define as funções de acesso (MANAGER e EMPLOYEE)
enum Role {
  MANAGER
  EMPLOYEE
}

// 2. Enum UserStatus: Define o status da conta (para forçar a troca de senha)
enum UserStatus {
  PENDING // Conta nova, deve trocar a senha
  ACTIVE // Conta ativa e validada
}

// 3. Enum UnitOfMeasure: A unidade de medida do produto
enum UnitOfMeasure {
  UNIT // Unidade (ex: garrafa, lata)
  KG // Quilograma
  LITER // Litro
}

// 4. Enum PaymentMethod: Formas de pagamento disponíveis
enum PaymentMethod {
  CASH // Dinheiro
  CARD // Cartão
  PIX // Transferência PIX
}

// 5. Enum SaleStatus: Status de uma venda
enum SaleStatus {
  COMPLETED // Venda finalizada
  CANCELED // Venda cancelada
}

// === MODELS ===

// Entidade User (Usuário)
model User {
  // Campos de Controle
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Campos de Identidade e Segurança
  name  String @default("Nome Não Definido")
  email String @unique // E-mail deve ser único

  // Regra de Negócio: Matrícula é o identificador único e corporativo
  registration String @unique

  password String // Senha (armazenada como hash)

  // Permissões e Status (Regras de Segurança Máxima)
  role   Role       @default(EMPLOYEE)
  status UserStatus @default(PENDING) // Padrão: PENDENTE de primeira troca de senha

  sales Sale[]

  // Nome da tabela no banco de dados
  @@map("user")
}

// MODELO DE FORNECEDOR
model Supplier {
  id           String  @id @default(uuid())
  name         String  @unique
  cnpj         String? // CNPJ é opcional no cadastro
  contactEmail String? // E-mail para contato (opcional)
  phone        String? // Telefone de contato (opcional)

  // Informações de Endereço (Essenciais para logística)
  street  String?
  city    String?
  state   String?
  zipCode String? // CEP

  products  Product[] // Relação 1:N com Product
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// MODELO DE CATEGORIA
model Category {
  id          String    @id @default(uuid())
  name        String    @unique // Ex: Hortifruti
  description String?
  products    Product[] // Relação 1:N com Product
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// MODELO DE PRODUTO
model Product {
  id              String          @id @default(uuid())
  name            String
  code            String          @unique // Código de barras deve ser único
  description     String?
  
  // Dados Financeiros e de Estoque
  price           Decimal        @db.Decimal(10, 2)
  cost            Decimal?       @db.Decimal(10, 2)
  stockQuantity   Int           @default(0)
  unitOfMeasure   UnitOfMeasure // Exige uma unidade do nosso Enum

  // Relacionamentos
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])

  // Supplier é OPCIONAL (supplierId?)
  supplierId      String? // FK para Fornecedor
  supplier        Supplier? @relation(fields: [supplierId], references: [id])

  // Flags de Controle
  isAvailable Boolean @default(true) // Disponível para venda

  // Batches (Lotes)
  batches         Batch[]

  // Itens de Venda
  saleItems       SaleItem[]

  // Promotions (Promoções)
  promotions      Promotion[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}


// MODELO DE LOTE
model Batch {
  id                String    @id @default(uuid())

  // Relacionamento
  productId          String
  product            Product   @relation(fields: [productId], references: [id])

  // Dados do Lote  
  code               String?    // opcional: identificador do lote/remessa
  receivedDate       DateTime?  @default(now())
  expirationDate     DateTime   // vencimento
  initialQuantity    Int        // quantidade que entrou
  currentQuantity    Int        // quantidade restante (para futuras vendas/baixa por vencimento)
  unitCost           Decimal   @db.Decimal(10, 2)

  // Relacionamentos de Venda
  saleItemBatches    SaleItemBatch[] // Relação com itens de venda que usam este lote

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([productId, expirationDate])
}

// MODELO DE VENDA
model Sale {
  id                String      @id @default(uuid())

  // Identificação do Vendedor (Snapshot)
  userId            String      // FK para User (quem vendeu)
  user              User        @relation(fields: [userId], references: [id])
  userName          String      // Snapshot do nome do vendedor na hora da venda
  
  // Dados Financeiros
  totalValue        Decimal     @db.Decimal(10, 2)
  paymentMethod     PaymentMethod

  // Status
  status            SaleStatus  @default(COMPLETED)

  // Auditoria de cancelamento
  canceledAt        DateTime?
  cancelReason      String?

  // Relacionamentos
  items             SaleItem[]  // Items da venda

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@map("sales")
}

// MODELO DE ITEM DE VENDA
model SaleItem {
  id                String      @id @default(uuid())

  // FK para Venda
  saleId            String
  sale              Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)

  // FK para Produto (informacional, para referência rápida)
  productId         String
  product           Product     @relation(fields: [productId], references: [id])

  // Snapshots (dados no momento da venda)
  productName       String      // Nome do produto na hora da venda
  quantity          Int         // Quantidade vendida
  unitPrice         Decimal     @db.Decimal(10, 2) // Preço unitário na hora da venda
  subTotal          Decimal     @db.Decimal(10, 2)

  // Relacionamento com Lotes
  batches           SaleItemBatch[] // Quais lotes foram usados para este item

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// MODELO DE LIGAÇÃO: ITEM DE VENDA COM LOTE
model SaleItemBatch {
  id                String      @id @default(uuid())

  // FK para Item de Venda
  saleItemId        String
  saleItem          SaleItem    @relation(fields: [saleItemId], references: [id], onDelete: Cascade)

  // FK para Lote
  batchId           String
  batch             Batch       @relation(fields: [batchId], references: [id])

  // Dados de Rastreamento
  quantity          Int         // Quantidade tirada DESTE lote específico
  unitCost          Decimal     @db.Decimal(10, 2) // Snapshot do custo do lote

  // GARANTIA: Um lote não pode aparecer duplicado no mesmo item de venda
  @@unique([saleItemId, batchId])
  
  @@index([batchId])
  @@map("sale_item_batches")
}

// MODELO DE PROMOÇÃO
model Promotion {
  id            String   @id @default(uuid())
  name          String
  description   String?
  discountType  String   // "PERCENTAGE" ou "FIXED_VALUE"
  discountValue Decimal  @db.Decimal(10, 2)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)

  // Relacionamento com Produto
  productId     String
  product       Product  @relation(fields: [productId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("promotion")
}
